# Copy to .env for local development (never commit .env).

# From your Redbooth app at https://redbooth.com/oauth2/applications
# Redirect URI must be: http://localhost:8765/callback
REDBOOTH_CLIENT_ID=
REDBOOTH_CLIENT_SECRET=

# Optional: skip OAuth entirely and use a static access token (expires!)
# REDBOOTH_ACCESS_TOKEN=

# Optional: disable all write tools
# REDBOOTH_READ_ONLY=true

# Optional: override token storage location
# REDBOOTH_TOKEN_PATH=~/.config/redbooth-mcp/tokens.json

# Optional: change the local OAuth callback port (update your app's redirect URI too)
# REDBOOTH_REDIRECT_PORT=8765
